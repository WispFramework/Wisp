<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>Wisp.Framework.Templates</PackageId>
    <Version>10.0.3</Version>
    <Authors>You</Authors>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <NoBuild>true</NoBuild>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPackaging>true</SuppressDependenciesWhenPackaging>

    <Authors>Jakub Sycha (utf-8x)</Authors>
    <Company>Wisp</Company>
    <Description>Project templates for the Wisp Framework</Description>
    <PackageProjectUrl>https://codeberg.org/WispFramework/Wisp</PackageProjectUrl>
    <RepositoryUrl>https://codeberg.org/WispFramework/Wisp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>web;framework;lightweight</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="src\**\*" Pack="true" PackagePath="content\src\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
  </ItemGroup>
</Project>